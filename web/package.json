{
  "name": "nox-yard-web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "docker:up": "docker compose -f ../compose.dev.yaml up -d --build",
    "build": "tsc --noEmit && vp build",
    "typecheck": "tsc --noEmit",
    "test": "node ../scripts/test-browser.mjs",
    "postinstall": "node --input-type=module -e \"import { existsSync } from 'node:fs'; if (existsSync('../scripts/install-hooks.mjs')) await import('./../scripts/install-hooks.mjs');\"",
    "check:code": "vp check",
    "format:check": "vp fmt --check",
    "format": "vp fmt"
  },
  "dependencies": {
    "@phosphor-icons/web": "2.1.2",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "typescript": "^6.0.0",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.6.0",
    "vite-plus": "1.6.0"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.6.0"
  },
  "engines": {
    "node": ">=26.13.1 <27"
  }
}
