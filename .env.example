# Bind to a trusted LAN/VPN interface. Use 127.0.0.1 when only a local reverse proxy should connect.
NOX_BIND_ADDRESS=0.0.0.0
NOX_PORT=8095

# Daily project image updates run at 03:00 in this server timezone (opt-in per project).
# Use an IANA name such as Europe/Lisbon. Independent of Yard self-update.
NOX_TIMEZONE=Etc/UTC

# Set this to the browser-facing origin when using a reverse proxy, for example https://nox.example.test
# Leave empty for direct local access. HTTPS origins enable Secure session cookies.
NOX_PUBLIC_URL=

# Optional machine API on the same service/port. Use an independent random key.
# Health and info are public even when protected routes are disabled.
NOX_YARD_API_ENABLED=false
NOX_YARD_API_KEY=

# Optional runtime override; empty uses build metadata, then dev.
NOX_YARD_VERSION=
