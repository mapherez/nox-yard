# Published host address for the Yard UI and Control API. Local access by default.
# Choose 0.0.0.0 explicitly for LAN/VPN access. A containerized reverse proxy
# must share a Docker network with Yard, or use a reachable host address.
NOX_BIND_ADDRESS=127.0.0.1
NOX_PORT=8095

# Separate MCP host port; MCP itself remains OFF until enabled in Settings.
# Choose an unused port. 127.0.0.1 restricts published access to this Docker host.
# Use 0.0.0.0 for LAN/VPN clients, with authenticated access enabled.
NOX_MCP_BIND_ADDRESS=127.0.0.1
NOX_MCP_PORT=8096
# Settings > MCP & access can persist these values and apply a service recreation.

# Daily project and Yard image updates use this server timezone; choose each time in its project drawer.
# Use an IANA name such as Europe/Lisbon.
NOX_TIMEZONE=Etc/UTC

# Required browser-facing Yard origin used for its exact NoX Login callback.
# HTTP private hostnames/IPs and HTTPS origins are supported.
NOX_PUBLIC_URL=http://yard.example.test
# Required HTTPS origin of the already running NoX Auth. Google credentials and
# the allowed-account list belong only to Auth, never to Yard.
NOX_AUTH_PUBLIC_URL=https://auth.example.test
# Optional: match custom Auth volume names; defaults match the Auth Compose.
# NOX_SUITE_LOCAL_VOLUME_NAME=nox-suite-local
# NOX_AUTH_ADMIN_VOLUME_NAME=nox-auth-admin

# Legacy first-start bootstrap for Control API access. Prefer generating a token
# in Settings. Imported keys are hashed once; rotation/revocation is authoritative
# in SQLite and an old environment key is never reimported on restart.
# Health and info are public even when protected routes are disabled.
NOX_YARD_API_ENABLED=false
NOX_YARD_API_KEY=

# Optional runtime override; empty uses build metadata, then dev.
NOX_YARD_VERSION=
