{
  "policy": "scripts/ci-policy.mjs",
  "go": true,
  "vite": [
    "web"
  ],
  "check": [
    {
      "command": "sh",
      "args": [
        "scripts/check.sh"
      ],
      "cwd": "."
    }
  ],
  "format": [
    {
      "command": "npm",
      "args": [
        "run",
        "format"
      ],
      "cwd": "web"
    }
  ],
  "yard": true
}
